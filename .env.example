# Copy to .env. Real environment variables take precedence over this file.

# Pick one LLM. Without any key the bot runs in extractive mode (no LLM, still cites pages).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic   # anthropic | openai | ollama | none
# LLM_MODEL=claude-haiku-5-5
# OLLAMA_HOST=http://localhost:11434

# Optional semantic search on top of keyword search: openai | ollama | none
EMBEDDINGS=none
# EMBEDDING_MODEL=text-embedding-3-small

DATA_DIR=data
# API_TOKEN=                # require "Authorization: Bearer <token>"
# MAX_UPLOAD_MB=20
# CHUNK_WORDS=120           # chunk size; re-index after changing it
# TOP_K=4                   # excerpts passed to the model
# LOG_LEVEL=INFO
